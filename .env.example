# Copy to .env and adjust. Every variable is optional unless marked otherwise;
# defaults are shown. Compose reads this file automatically.

# ── Common ──────────────────────────────────────────────────────────────────

# Container timezone. The hub uses local wall-clock time everywhere
# ("today", recurring items, budgets), so set this to YOUR timezone.
TZ=UTC

# debug | info | warn | error | silent
#LOG_LEVEL=warn

# ── Home setup (docker-compose.yml) ─────────────────────────────────────────

# Host port the hub is published on.
#PORT=8787

# Set to true only after HTTPS works (scripts/setup-https.sh),
# otherwise the browser rejects the session cookie and sign-in breaks.
#SECURE_COOKIES=false

# Network name for local HTTPS. Must match the machine's Bonjour name —
# see scripts/setup-https.sh, it sets this for you.
#HUB_HOST=hub.local

# ── Production (docker-compose.prod.yml) ────────────────────────────────────

# REQUIRED in production: the domain the hub is served on.
# Caddy obtains a Let's Encrypt certificate for it automatically.
#HUB_DOMAIN=hub.example.com

# Where the hub's data lives on the server (owned by uid 1000).
#DATA_DIR=/srv/family-hub/data

# Public key for encrypted backups (scripts/backup.sh). Empty disables
# pushing backups; unencrypted archives are never pushed.
#AGE_RECIPIENT=age1...

# Google sign-in (optional). Both values come from Google Cloud Console
# (OAuth client, Web application). Empty values disable the feature.
#GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Public demo (docker-compose.demo.yml overlay) ───────────────────────────

# Domain for the public demo sandbox (needs a DNS A record).
#DEMO_DOMAIN=demo.example.com

# Where the throwaway demo data lives.
#DEMO_DATA_DIR=/srv/family-hub/demo-data
